# ==============================================================================
# BUILD WITH NEO PLATFORM - ENVIRONMENT VARIABLES
# ==============================================================================
# Duplicate this file as '.env.local' and provide your actual API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLERK AUTHENTICATION CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Clerk Dashboard (https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Clerk standard route redirects
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Clerk Webhook Secret (for syncing user sign-ups into Supabase profiles)
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_signing_secret_here

# ------------------------------------------------------------------------------
# 2. SUPABASE DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API (https://supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_anon_key_here

# Supabase Service Role Key (Server-side ONLY for admin tasks & webhooks)
# CAUTION: Never expose this key in public client-side code!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your_service_role_key_here

# ------------------------------------------------------------------------------
# 3. CLERK + SUPABASE INTEGRATION JWT SECRET
# ------------------------------------------------------------------------------
# Found in Supabase Settings -> API -> JWT Settings -> JWT Secret
# Used when creating the 'supabase' JWT Template in Clerk Dashboard:
# JWT template name in Clerk MUST be exactly 'supabase'
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_here

# ------------------------------------------------------------------------------
# 4. ADMIN PAGE (/admin)
# ------------------------------------------------------------------------------
# Optional. A long random value that unlocks /admin.
# Leave it empty to allow only Clerk users with { "role": "admin" } in public metadata.
ADMIN_SECRET_PASSCODE=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
